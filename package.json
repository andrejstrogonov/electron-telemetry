{
  "name": "electron-telemetry",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:test": "cross-env TELEMETRY_MODE=test electron .",
    "start:prod": "cross-env TELEMETRY_MODE=prod electron .",
